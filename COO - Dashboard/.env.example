# Execução local (npm run start:local). Copie para .env e NÃO faça commit do .env.
AZURE_SQL_SERVER=rdb-ibp-bmsa-prd.database.windows.net
AZURE_SQL_DATABASE=BDIBPBMSA_PRD
AZURE_SQL_PORT=1433
AZURE_SQL_USER=
AZURE_SQL_PASSWORD=

# IBP.DASHBOARD.ID_DASH dos indicadores do COO (scripts em database/ usam 15)
COO_ID_DASH=15

# Fora do Databricks Apps não existe o cabeçalho X-Forwarded-Email.
# Para testar o controle de acesso localmente, informe um e-mail cadastrado
# em IBP.USERS com CD_MATRICULA preenchido:
COO_ACESSO_LOCAL_EMAIL=
# Só em desenvolvimento, para abrir sem validar acesso (o log avisa):
# COO_ACESSO=desligado

PORT=8000
